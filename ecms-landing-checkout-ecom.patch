+        <span className="text-2xl font-black text-gray-900 dark:text-slate-100">{formatTaka(p)}</span>
+        <span className="text-xs font-medium text-gray-500 dark:text-slate-400">{billingText(billingDays)}</span>
+        {hasDiscount && (
